flowchart TD
    Start["Start Model Download"] --> Check{"Model already<br/>downloaded?"}
    Check -->|"Yes"| Done["Load from cache"]
    Check -->|"No"| Primary["Download from<br/>HuggingFace (primary)"]
    
    Primary --> PrimaryOK{"Success?"}
    PrimaryOK -->|"Yes"| Save["Save to AppDataDirectory"]
    PrimaryOK -->|"No"| Mirror["Download from<br/>hf-mirror.com (China mirror)"]
    
    Mirror --> MirrorOK{"Success?"}
    MirrorOK -->|"Yes"| Save
    MirrorOK -->|"No"| Cleanup["Clean up partial file"]
    
    Cleanup --> Error["Throw error with<br/>user-friendly message"]
    
    Save --> Progress["Report progress<br/>(throttled at ≥0.5% intervals)"]
    Progress --> Load["Load model into memory"]
    Load --> Done

    subgraph Settings["Settings"]
        Cancel["User clicks Cancel"]
        Cancel -->|"CancellationToken"| CancelCleanup["Clean up partial file"]
        CancelCleanup --> CancelMsg["Show: Download Cancelled"]
    end

    Primary -.->|User cancels| Cancel
    Mirror -.->|User cancels| Cancel

    style Start fill:#e3f2fd,stroke:#1565C0,color:#000
    style Done fill:#e8f5e9,stroke:#2E7D32,color:#000
    style Error fill:#fce4ec,stroke:#C62828,color:#000
    style CancelMsg fill:#fff3e0,stroke:#e65100,color:#000
