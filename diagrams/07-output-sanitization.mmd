flowchart TD
    Raw["Raw LLM Output"] --> Layer1["Layer 1:<br/>Anti-Prompt Stripping"]
    
    Layer1 --> Layer2["Layer 2:<br/>Repetition Detection"]
    
    Layer1_Note["Remove trailing control tokens:<br/><|im_end|>, <|eot_id|>, &lt;/s&gt;"]
    Layer1 -.-> Layer1_Note
    
    Layer2 --> Decis{"Line content<br/>identical to<br/>previous line?"}
    
    Decis -->|"No (unique)"| Keep["Keep line"]
    Decis -->|"Yes, &lt; 2 repeats"| Keep2["Keep (allow natural emphasis)"]
    Decis -->|"Yes, ≥ 2 repeats"| Drop["Drop (loop detected)"]
    
    Keep --> Next["Process next line"]
    Keep2 --> Next
    Drop --> Next
    
    Next --> More{"More lines?"}
    More -->|"Yes"| Layer2
    More -->|"No"| Done["Cleaned Output"]
    
    subgraph PreProcess["Pre-Processing"]
        TS["Timestamp Removal:<br/>Strip [HH:mm:ss] prefix<br/>before comparison"]
    end
    
    TS -.-> Decis
    
    subgraph Sampling["Sampling Configuration"]
        RP["Repeat Penalty: 1.2<br/>(discourages token loops)"]
    end
    
    RP -.->|At inference time| Raw

    style Raw fill:#fce4ec,stroke:#C62828,color:#000
    style Done fill:#e8f5e9,stroke:#2E7D32,color:#000
    style Layer1 fill:#fff3e0,stroke:#e65100,color:#000
    style Layer2 fill:#fff3e0,stroke:#e65100,color:#000
    style Sampling fill:#e3f2fd,stroke:#1565C0,color:#000
